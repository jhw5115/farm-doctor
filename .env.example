# Application
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:8000

# MySQL (use Secrets Manager values in AWS; never commit a real password)
MYSQL_DATABASE=farm_doctor
MYSQL_USER=farm_doctor
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-development-only
DATABASE_URL=mysql+pymysql://farm_doctor:local-development-only@db:3306/farm_doctor?charset=utf8mb4

# Storage (ECS uses an IAM task role, not access keys)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_CREATE_BUCKET=false
AWS_REGION=ap-northeast-2
MODEL_PATH=/app/models/best.pt
MODEL_VERSION=apple_binary_v1
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=10
CORS_ORIGINS=http://localhost:5173

# Chatbot (server-side only; do not expose these as VITE_ variables)
OPENAI_API_KEY=
CHAT_MODEL=
CHAT_REQUESTS_PER_MINUTE=10
CHAT_MAX_INPUT_CHARS=1000
CHAT_TIMEOUT_SECONDS=30
CHAT_RETENTION_DAYS=30
OPENAI_VECTOR_STORE_ID=
