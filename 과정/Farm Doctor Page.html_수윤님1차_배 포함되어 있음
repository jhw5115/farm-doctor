        function downloadPDFReport() {
            alert('농업기술센터 제출용 [과수화상병 긴급 방제 진단 보고서.pdf] 다운로드가 시작됩니다.');
        }

        // CHATBOT INTERACTION SIMULATION
        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            appendChatMessage('user', text);
            input.value = '';

            // Simulate Bot AI Response
            setTimeout(() => {
                let reply = "농가님의 질문을 분석 중입니다. 화상병 발생 시 가지를 30cm 이상 자르고 소독하는 것이 중요합니다.";
                if (text.includes('요약') || text.includes('상태')) {
                    reply = "현재 분석된 과수원 상태: 총 12개 검사 샘플 중 사과화상병 2건, 배화상병 2건이 확인되었습니다. 신속한 1399 신고를 권장합니다.";
                } else if (text.includes('매립') || text.includes('절차') || text.includes('예방')) {
                    reply = "과수화상병 법정 매립 절차:\n1. 1399 확진 신고\n2. 반경 100m 이내 과수 이동 제한\n3. 매립지 깊이 3m 이상 굴착 및 석회 처리 후 매립 조치";
                }
                appendChatMessage('bot', reply);
            }, 600);
        }

        function sendQuickPrompt(promptText) {
            document.getElementById('chat-input').value = promptText;
            handleChatSubmit(new Event('submit'));
        }

        function appendChatMessage(sender, text) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');

            if (sender === 'user') {
                div.className = 'flex items-start justify-end space-x-3';
                div.innerHTML = `
                    <div class="max-w-[80%] bg-sage-500 text-white p-3.5 rounded-2xl rounded-tr-none text-sm shadow-sm">
                        ${text}
                    </div>
                `;
            } else {
                div.className = 'flex items-start space-x-3';
                div.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-sage-500 text-white flex items-center justify-center text-xs flex-shrink-0 mt-1">
                        <i class="fa-solid fa-robot"></i>
