        // INIT ON LOAD
        window.onload = function() {
            renderGallery(sampleItems);
        };

        // TAB SWITCHING (Main vs Gallery vs Chatbot)
        function switchTab(tabKey) {
            // Hide all pages
            document.querySelectorAll('.page-section').forEach(el => el.classList.add('hidden'));
            
            // Show selected page
            const target = document.getElementById(`section-${tabKey}`);
            if (target) target.classList.remove('hidden');

            // Reset navbar button styles
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-sage-500', 'text-white', 'shadow-md');
                btn.classList.add('text-sage-700', 'hover:bg-sage-100');
            });

            // Highlight active navbar button
            const activeNav = document.getElementById(`nav-${tabKey}`);
            if (activeNav) {
                activeNav.classList.remove('text-sage-700', 'hover:bg-sage-100');
                activeNav.classList.add('bg-sage-500', 'text-white', 'shadow-md');
            }
        }

        // DRAG AND DROP UPLOAD SIMULATION
        function handleFileSelect(e) {
            const files = e.target.files;
            if (!files.length) return;

            const previewContainer = document.getElementById('preview-container');
            previewContainer.classList.remove('hidden');
            previewContainer.innerHTML = '';

            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const div = document.createElement('div');
                    div.className = 'relative rounded-2xl overflow-hidden border border-sage-200 bg-gray-100 h-28 group';
                    div.innerHTML = `
                        <img src="${evt.target.result}" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                            <span class="text-[10px] bg-sage-500 text-white px-2 py-1 rounded-full">업로드 완료</span>
                        </div>
                    `;
                    previewContainer.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }

        // YOLO DETECTION SIMULATION
        function simulateYoloDetection() {
            const btn = document.getElementById('btn-run-detection');
            const originalHTML = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-2"></i> best.pt 추론 중...`;

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = originalHTML;

                // Toast Message
                alert('YOLOv8 모델 분석이 완료되었습니다!\n결과: 사과화상병 2건, 배화상병 2건, 정상 8건 탐지.');
                
                // Switch to Gallery View to see results
                switchTab('gallery');
            }, 1200);
        }

        // GALLERY RENDERING & FILTERS
        function renderGallery(items) {
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';

            items.forEach(item => {
                let badgeClass = 'bg-emerald-500';
                if (item.type === 'apple_blight') badgeClass = 'bg-dustyRed';
                if (item.type === 'pear_blight') badgeClass = 'bg-amber-600';

                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl overflow-hidden border border-sage-100 shadow-sm hover:shadow-md transition-all group cursor-pointer';
                card.onclick = () => openImageModal(item);

                card.innerHTML = `
                    <div class="relative h-44 bg-gray-900 overflow-hidden">
                        <img src="${item.img}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                        
                        <!-- Simulated Bounding Box -->
                        <div class="absolute border-2 border-white/80 rounded" style="top: ${item.top}; left: ${item.left}; width: ${item.width}; height: ${item.height};">
                            <span class="${badgeClass} text-white text-[9px] font-bold px-1.5 py-0.5 rounded absolute -top-3 left-0 shadow-sm">
                                ${item.label} ${(item.score * 100).toFixed(0)}%
                            </span>
                        </div>
                    </div>
                    <div class="p-4 flex items-center justify-between">
                        <div>
                            <h4 class="text-xs font-bold text-gray-800">${item.title}</h4>
                            <p class="text-[10px] text-gray-400 mt-0.5">YOLOv8 Confidence: ${item.score}</p>
                        </div>
                        <span class="w-7 h-7 rounded-full bg-sage-50 text-sage-600 flex items-center justify-center text-xs group-hover:bg-sage-500 group-hover:text-white transition-colors">
                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                        </span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterGallery(category) {
            // Update filter button style
            document.querySelectorAll('.gallery-filter-btn').forEach(btn => {
                btn.classList.remove('bg-sage-500', 'text-white');
                btn.classList.add('bg-sage-50', 'text-sage-700');
            });

            if (category === 'all') {
                renderGallery(sampleItems);
            } else {
                const filtered = sampleItems.filter(i => i.type === category);
                renderGallery(filtered);
            }
        }

        // MODAL HANDLERS
        function openImageModal(item) {
            document.getElementById('modal-title').innerText = item.title;
            document.getElementById('modal-img').src = item.img;
            document.getElementById('modal-label').innerText = `${item.label} ${(item.score * 100).toFixed(1)}%`;
            document.getElementById('modal-score').innerText = item.score;
            document.getElementById('modal-class-text').innerText = item.label;

            const bbox = document.getElementById('modal-bbox');
            bbox.style.top = item.top;
            bbox.style.left = item.left;
            bbox.style.width = item.width;
            bbox.style.height = item.height;

            document.getElementById('image-modal').classList.remove('hidden');
        }

        function closeImageModal() {
            document.getElementById('image-modal').classList.add('hidden');
        }

        function openReportModal() {
            document.getElementById('report-modal').classList.remove('hidden');
        }

        function closeReportModal() {
            document.getElementById('report-modal').classList.add('hidden');
        }

